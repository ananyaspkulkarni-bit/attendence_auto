# AttendEase Environment Configuration Example
# Copy this file to .env and adjust values if needed

# Default target attendance percentage threshold (e.g. 75.0)
ATTENDANCE_THRESHOLD=75.0

# Path to attendance excel file
EXCEL_PATH=data/sample_attendance.xlsx

# Reporting output directory
REPORT_OUTPUT_DIR=reports

# Database path for persistent delivery history (Stage 3)
DB_PATH=data/delivery_history.db

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ==============================================================================
# Stage 2: Email & SMTP Configuration
# ==============================================================================
# Set DRY_RUN=true for offline preview mode (default). Set DRY_RUN=false for real sending.
DRY_RUN=true

# SMTP Server details (e.g. smtp.gmail.com for Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication credentials
# Note: For Gmail with 2FA, create and use a 16-character App Password.
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password_here

# Sender email address
SENDER_EMAIL=your_email@example.com

# Explicit test recipient address (Only sending to this address is allowed in Stage 2)
TEST_RECIPIENT_EMAIL=test_recipient@example.com
